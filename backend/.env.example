# development (API docs on) | production. Anything but development/test is a deployment: no docs, HSTS,
# and the API refuses to start with unsafe settings (http origins, a wildcard origin, no SECRETS_KEY...)
APP_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Supabase > Project Settings > Database > Connection string (Session pooler, port 5432)
# Change the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

SUPABASE_URL=https://<project-ref>.supabase.co
# SERVER ONLY. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still signs JWTs with the legacy HS256 secret.
SUPABASE_JWT_SECRET=

# Public online-admission pages: limits per client IP (per API process)
ADMISSION_SUBMITS_PER_HOUR=10
ADMISSION_LOOKUPS_PER_10MIN=30
# Reverse proxies in front of the API that set X-Forwarded-For (0 = none). Used to find the
# client IP for the limits above; with 0 the header is ignored, because clients can forge it.
TRUSTED_PROXY_HOPS=0
# Run uvicorn with --no-proxy-headers so only TRUSTED_PROXY_HOPS decides the client IP (audit log, rate limits).
# Refuse a token as soon as its Supabase sign-in session ends (signed out / ended by an admin)
SESSION_CHECK=true
# Largest request body in MB (the admission form and homework allow more)
MAX_REQUEST_MB=12
# Where rate-limit counts are kept: database (shared by every API process/server — needed with
# uvicorn --workers N or several containers), memory (this process only), or auto (memory in
# development, database in a deployment). Needs migration 0033.
RATE_LIMIT_BACKEND=auto

# Encrypts each school's Razorpay, Twilio and WhatsApp secrets in the database.
# Generate it once and keep it safe (losing or changing it means the schools must enter
# their keys again):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (PAYMENT_SECRETS_KEY, its earlier name, is still accepted.)
SECRETS_KEY=
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# Subscription billing: the PLATFORM's own Razorpay account, which schools use to pay their
# subscription invoices (separate from each school's account for fees). Empty = schools pay by
# bank transfer and the super admin records it. Never put these in the frontend.
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
# The secret you set on the webhook in the platform's Razorpay dashboard, pointed at
#   <PUBLIC_API_URL>/api/v1/billing/webhooks/razorpay
# (events: payment.captured, payment.failed, order.paid, refund.processed). Empty = webhooks refused.
PLATFORM_RAZORPAY_WEBHOOK_SECRET=
# Renewal invoices are issued inside the API process (hourly). Set false to run them another way:
#   POST /api/v1/admin/billing/run (super admin), or the scheduler of your choice calling it
BILLING_WORKER=true
BILLING_INTERVAL_SECONDS=3600

# Notifications
# The API's public address: Twilio and WhatsApp send delivery reports to it, and it is shown
# to admins for the webhook set-up.
PUBLIC_API_URL=http://localhost:8000
# The sender runs inside the API process. Set false to run it separately instead:
#   python -m scripts.notify_worker
NOTIFY_WORKER=true
NOTIFY_INTERVAL_SECONDS=5
# Email (one mail server for the whole platform; each school's name is the sender name).
# Leave SMTP_HOST empty to turn email off (messages are then recorded as "not sent").
SMTP_HOST=
# SMTP_SECURITY: starttls (port 587) | ssl (port 465) | none
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# SMS (Twilio) and WhatsApp (Meta Cloud API) accounts are per school, entered by the school
# admin under Communication -> Channels. Only change these to point at a test stand-in:
# TWILIO_API_BASE=https://api.twilio.com
# WHATSAPP_API_BASE=https://graph.facebook.com
# WHATSAPP_API_VERSION=v21.0

# Push notifications (Web Push: Android, iPhone/iPad home-screen app, desktop browsers).
# Make a key pair once:  python -m scripts.generate_vapid_keys
# Keep the private key secret; changing it means every device must allow notifications again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# How push services can reach you: mailto:you@yourdomain.in or https://yourdomain.in
VAPID_SUBJECT=
# Only for a test stand-in; leave unset in production (the browsers' own push services are used).
# PUSH_ALLOWED_HOSTS=http://localhost:9996
